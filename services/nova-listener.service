[Unit]
Description=Project Nova wake-word listener
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Project-Nova/nova-cortex
ExecStart=/usr/bin/python3 -m nova.audio.wake --project-root %h/Project-Nova
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
